{
  "$schema" : "https://docs.renovatebot.com/renovate-schema.json",
  "extends" : [
    "config:recommended"
  ],
  "schedule" : [
    "every weekend"
  ],
  "timezone" : "Asia/Singapore",
  "packageRules" : [
    {
      "description" : "typescript-eslint does not support TypeScript 7 yet",
      "matchPackageNames" : [
        "typescript"
      ],
      "allowedVersions" : "<7"
    }
  ]
}
