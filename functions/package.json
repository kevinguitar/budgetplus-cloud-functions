  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^14.0.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "eslint": "^10.0.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import-x": "^4.18.1",
    "firebase-functions-test": "^3.0.0",
    "globals": "^17.14.0",
    "typescript": "^5.0.0"
  },
  "private": true
